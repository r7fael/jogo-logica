{
  "rewrites": [
    {
      "source": "/",
      "destination": "/jogo/index.html"
    },
    {
      "source": "/script.js",
      "destination": "/jogo/script.js"
    },
    {
      "source": "/styles.css",
      "destination": "/jogo/styles.css"
    },
    {
      "source": "/config.js",
      "destination": "/jogo/config.js"
    },
    {
      "source": "/jogo/:path*",
      "destination": "/jogo/:path*"
    }
  ]
}
